#!/usr/bin/env python3
import asyncio
import re
from tcp import Servidor
# Garante o event loop no Python 3.14+
loop = asyncio.new_event_loop()
asyncio.set_event_loop(loop)

# Dicionário global para mapear apelido (em minúsculas) -> objeto conexao
USUARIOS = {}
CANAIS = {}  # canal_lower -> set(conexao1, conexao2, ...)

def validar_nome(nome):
    return re.match(br'^[a-zA-Z][a-zA-Z0-9_-]*$', nome) is not None

def dados_recebidos(conexao, dados):
    if not dados:
        return

    if not hasattr(conexao, 'buffer'):
        conexao.buffer = b''

    conexao.buffer += dados

    while b'\r\n' in conexao.buffer:
        linha, conexao.buffer = conexao.buffer.split(b'\r\n', 1)
        texto = linha.decode('utf-8', errors='ignore').strip()

        # Passo 1 & 2: PING
        if texto.startswith('PING'):
            partes = texto.split(' ', 1)
            payload = partes[1] if len(partes) > 1 else ''
            resposta = f":server PONG server :{payload}\r\n"
            conexao.enviar(resposta.encode('utf-8'))

        # Passo 3 & 4: NICK
        elif texto.startswith('NICK'):
            partes = texto.split(' ', 1)
            apelido = partes[1] if len(partes) > 1 else ''
            
            if not validar_nome(apelido.encode('utf-8')):
                apelido_atual = getattr(conexao, 'apelido', '*')
                resposta = f":server 432 {apelido_atual} {apelido} :Erroneous nickname\r\n"
                conexao.enviar(resposta.encode('utf-8'))
            else:
                apelido_lower = apelido.lower()
                apelido_antigo = getattr(conexao, 'apelido', None)

                if apelido_lower in USUARIOS and USUARIOS[apelido_lower] != conexao:
                    apelido_atual = apelido_antigo if apelido_antigo else '*'
                    resposta = f":server 433 {apelido_atual} {apelido} :Nickname is already in use\r\n"
                    conexao.enviar(resposta.encode('utf-8'))
                else:
                    if apelido_antigo:
                        del USUARIOS[apelido_antigo.lower()]
                        resposta = f":{apelido_antigo} NICK {apelido}\r\n"
                        conexao.enviar(resposta.encode('utf-8'))
                    else:
                        resposta = f":server 001 {apelido} :Welcome\r\n:server 422 {apelido} :MOTD File is missing\r\n"
                        conexao.enviar(resposta.encode('utf-8'))

                    conexao.apelido = apelido
                    USUARIOS[apelido_lower] = conexao

                 # Passo 5: PRIVMSG (Direto ou Canal)
        elif texto.startswith('PRIVMSG'):
            partes = texto.split(' ', 2)
            if len(partes) >= 3:
                destinatario = partes[1]
                mensagem = partes[2]
                
                if not mensagem.startswith(':'):
                    mensagem = ':' + mensagem

                destinatario_lower = destinatario.lower()
                remetente = getattr(conexao, 'apelido', '*')

                # 1. Envio para CANAL (#)
                if destinatario.startswith('#'):
                    if destinatario_lower in CANAIS:
                        resposta = f":{remetente} PRIVMSG {destinatario} {mensagem}\r\n"
                        for membro in CANAIS[destinatario_lower]:
                            # Opcional/Recomendado: não reenviar para o próprio remetente no canal
                            if membro != conexao:
                                membro.enviar(resposta.encode('utf-8'))
                
                # 2. Envio DIRETO para USUÁRIO
                elif destinatario_lower in USUARIOS:
                    conexao_destino = USUARIOS[destinatario_lower]
                    resposta = f":{remetente} PRIVMSG {destinatario} {mensagem}\r\n"
                    conexao_destino.enviar(resposta.encode('utf-8'))

        # Passo 6: JOIN
        elif texto.startswith('JOIN'):
            partes = texto.split(' ', 1)
            canal = partes[1] if len(partes) > 1 else ''
            
            # Nome do canal deve começar com '#' e a parte após o '#' deve ser um nome válido
            if not canal.startswith('#') or not validar_nome(canal[1:].encode('utf-8')):
                apelido_atual = getattr(conexao, 'apelido', '*')
                resposta = f":server 475 {apelido_atual} {canal} :Cannot join channel (+b)\r\n"
                conexao.enviar(resposta.encode('utf-8'))
            else:
                canal_lower = canal.lower()
                
                if canal_lower not in CANAIS:
                    CANAIS[canal_lower] = set()
                
                CANAIS[canal_lower].add(conexao)
                
                if not hasattr(conexao, 'canais'):
                    conexao.canais = set()
                conexao.canais.add(canal_lower)

                apelido = getattr(conexao, 'apelido', '*')
                msg_join = f":{apelido} JOIN :{canal}\r\n"

                # Notifica todos no canal (incluindo quem acabou de entrar)
                for membro in CANAIS[canal_lower]:
                    membro.enviar(msg_join.encode('utf-8'))

                # Envia lista 353 e 366
                membros_nicks = " ".join(sorted([getattr(c, 'apelido', '*') for c in CANAIS[canal_lower]]))
                r_353 = f":server 353 {apelido} = {canal} :{membros_nicks}\r\n"
                r_366 = f":server 366 {apelido} {canal} :End of /NAMES list.\r\n"
                
                conexao.enviar(r_353.encode('utf-8'))
                conexao.enviar(r_366.encode('utf-8'))
      
def conexao_aceita(conexao):
    print(conexao, 'nova conexão')

    # Note que, no Python, atributos NÃO precisam ser previamente declarados na classe!
    # Se precisar, esta função é o melhor local para adicionar novos atributos ao objeto conexao.
    #
    # Por exemplo, para armazenar o nick do usuário:
    conexao.nick = b'*'

    # Fique à vontade para adicionar mais atributos, se necessário.

    conexao.registrar_recebedor(dados_recebidos)


servidor = Servidor(6667)
servidor.registrar_monitor_de_conexoes_aceitas(conexao_aceita)
asyncio.get_event_loop().run_forever()


loop.run_forever()